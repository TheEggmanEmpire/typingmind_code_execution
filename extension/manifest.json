{
  "manifest_version": 3,
  "name": "Code Runner Browser Bridge",
  "version": "0.3.0",
  "description": "Companion for the Code Runner TypingMind plugin: lets its browser tools read, snapshot and operate your open tabs. Paired to TypingMind with a key.",
  "permissions": ["tabs", "scripting", "debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": ["content.js"]
    }
  ]
}
