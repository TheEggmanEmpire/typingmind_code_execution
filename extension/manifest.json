{
  "manifest_version": 3,
  "name": "Code Runner Browser Bridge",
  "version": "0.5.0",
  "description": "Companion browser bridge for Code Runner: trusted TypingMind frames and paired remote MCP clients.",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Code Runner Browser Bridge"
  }
}
