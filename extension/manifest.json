{
  "manifest_version": 3,
  "name": "Code Runner Browser Bridge",
  "version": "0.5.3",
  "description": "Lets the Code Runner MCP server (LibreChat, Hermes and other MCP clients) read and operate your open tabs, after you pair it. Also serves the Code Runner plugin in TypingMind.",
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Code Runner Browser Bridge"
  }
}
